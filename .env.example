# Copy this file to .env and fill in your own values. Never commit .env.
# The README has a step-by-step setup guide.

# ── Supabase (required) ──────────────────────────────────────────────────────
# Create a project at https://supabase.com/dashboard, then:
#   URL:              Project Settings → API → Project URL
#   Publishable key:  Project Settings → API Keys → "publishable" (or legacy "anon") key
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The same two values again. The browser can only see variables that start with VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Only read by src/integrations/supabase/client.server.ts, which nothing imports yet.
# Server-side only; bypasses row-level security. Never expose it to the browser.
# Project Settings → API Keys → "secret" (or legacy "service_role") key.
# SUPABASE_SERVICE_ROLE_KEY=

# ── AI statement extraction (required to process uploaded statements) ────────
# Choose ONE provider and set only that provider's key. The others can stay empty.
#   anthropic → Claude    key from https://console.anthropic.com/settings/keys
#   openai    → OpenAI    key from https://platform.openai.com/api-keys
#   google    → Gemini    key from https://aistudio.google.com/apikey
# Free tiers are fine for trying the app out. Use a paid tier for real customer statements,
# because free tiers may use submitted data to train models.
AI_PROVIDER=

# Set the key that matches AI_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional model overrides. Defaults are used when these are unset:
#   claude-sonnet-5-5, gpt-6.1-sol, gemini-3.8-flash
# Model ids move quickly. If a default is retired, set the override to a current model id.
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# GOOGLE_MODEL=

# ── Deployment (optional) ────────────────────────────────────────────────────
# Where the production build is packaged for. Defaults to "vercel". Other examples:
# "node-server", "cloudflare-module". See https://nitro.build/deploy
# NITRO_PRESET=

# ── Database migrations (optional) ───────────────────────────────────────────
# Postgres connection string, used only by drizzle-kit (drizzle.config.ts).
# Supabase dashboard → Connect → copy the "Session pooler" or "Direct connection" URI and
# replace [YOUR-PASSWORD] with your database password (Project Settings → Database).
DATABASE_URL=
